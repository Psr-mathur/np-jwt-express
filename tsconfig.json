{
	"compilerOptions": {
		"moduleResolution": "node",
		"rootDir": ".",
		"outDir": "dist",
		"sourceMap": true,
		"target": "esnext",
		"module": "commonjs",
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"types": ["node"],
		"noImplicitAny": true,
		"allowJs": true,
		"baseUrl": ".",
		"paths": {
			"@/*": ["src/*"]
		}
	},
	"include": ["."],
	"exclude": ["node_modules", "dist"]
}
